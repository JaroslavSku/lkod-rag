{
  "name": "lkod-rag",
  "version": "1.0.0",
  "description": "Hybrid RAG API over a document set - PostgreSQL full-text search combined with pgvector embeddings, fused by Reciprocal Rank Fusion and answered by a local Ollama model.",
  "main": "dist/index.js",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev-start": "tsx watch --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:only": "tsx --import ./test/setup.ts --test \"test/**/*.test.ts\"",
    "test": "npm run typecheck && npm run test:only",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "migrate-db": "node node_modules/db-migrate/bin/db-migrate up"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "db-migrate": "^0.11.14",
    "db-migrate-pg": "^1.5.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "pgvector": "^0.3.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  }
}
